# ── 依赖目录（通过 composer install 安装）──
/web/vendor/

# ── Python 虚拟环境 ──
.venv/

# ── 敏感配置（含真实密码，不上传）──
/web/application/config/database.php

# ── IDE 和编辑器 ──
.idea/
.vscode/
*.swp
*.swo

# ── 临时文件和日志 ──
/web/application/logs/*.php
!/web/application/logs/index.html
/web/application/cache/*
!/web/application/cache/index.html
temp_*.txt
*.log

# ── Redis 持久化文件 ──
dump.rdb

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code 配置 ──
.claude/

# ── 文档文件（二进制，不上传）──
*.docx
*.pdf
*.doc
