# ── 依赖目录（通过 composer install 安装）──
/web/vendor/

# ── Python 虚拟环境 ──
.venv/

# ── Python 缓存 ──
__pycache__/
*.pyc

# ── API 测试脚本（开发调试用）──
test_api_full.py

# ── 敏感配置（含真实密码，不上传）──
/web/application/config/database.php

# ── IDE 和编辑器 ──
.idea/
.vscode/
*.swp
*.swo

# ── 临时文件和日志 ──
/web/application/logs/*.php
!/web/application/logs/index.html
/web/application/cache/*
!/web/application/cache/index.html
temp_*.txt
*.log

# ── Redis 持久化文件 ──
dump.rdb

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code 配置 ──
.claude/

# ── 文档文件（二进制，不上传）──
*.docx
*.pdf
*.doc

# ── 边缘AI（人员A）生成文件 ──
edge-ai/output/logs/
edge-ai/output/clips/
edge-ai/output/export/*.rknn
edge-ai/output/export/*.pt
edge-ai/output/export/*.onnx
edge-ai/output/yolo_train/
edge-ai/data/smoke_dataset/
edge-ai/__pycache__/
edge-ai/edge/__pycache__/
edge-ai/localization/__pycache__/
*.pt
*.onnx
*.rknn
edge-ai/edge_config.json

# ── 上传目录 ──
web/uploads/
